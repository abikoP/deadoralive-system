# ===========================================
# Dead or Alive System - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ===========================================
# Manager Service (Rust Application)
# ===========================================

# JWT Secret for authentication (generate a strong random string)
# Example: openssl rand -base64 32
JWT_SECRET=your-secret-key-here-change-this-in-production

# Database path (SQLite)
DATABASE_URL=sqlite:///data/db.sqlite

# Server configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8081

# Telegraf container name (for Docker control)
TELEGRAF_CONTAINER_NAME=telegraf

# ===========================================
# InfluxDB Configuration
# ===========================================

# InfluxDB admin credentials
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=change-this-password-in-production

# InfluxDB database name
INFLUXDB_DB=monitoring

# InfluxDB retention policy (e.g., 30d, 90d, INF)
INFLUXDB_RETENTION=90d

# ===========================================
# Grafana Configuration
# ===========================================

# Grafana admin credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-password-in-production

# Grafana server configuration
GRAFANA_SERVER_ROOT_URL=https://doa.com

# ===========================================
# Nginx Configuration
# ===========================================

# Domain names
DOMAIN_GRAFANA=doa.com
DOMAIN_MANAGER=admin.doa.com

# SSL/TLS Configuration
# Set to "letsencrypt" for Let's Encrypt, "acm" for AWS ACM
SSL_MODE=letsencrypt

# Let's Encrypt email (required if SSL_MODE=letsencrypt)
LETSENCRYPT_EMAIL=your-email@example.com

# ===========================================
# Telegraf Configuration
# ===========================================

# Monitoring interval (default: 10s)
TELEGRAF_INTERVAL=10s

# Monitoring timeout (default: 5s)
TELEGRAF_TIMEOUT=5s

# ===========================================
# Docker Compose Configuration
# ===========================================

# Compose project name
COMPOSE_PROJECT_NAME=deadoralive

# ===========================================
# Security Notes
# ===========================================
# 1. NEVER commit .env file to version control
# 2. Use strong, unique passwords for production
# 3. Rotate JWT_SECRET regularly
# 4. Keep this file secure with appropriate permissions (chmod 600 .env)
